rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 炎リアクション用: reactionCount だけを ±1 する更新かどうか。
    // これにより、投稿者以外の人でもリアクションの数だけは更新できる
    // (Cloud Functionsを使わずにクライアント側だけで集計を完結させるため)。
    function isReactionCountToggle() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount'])
        && (request.resource.data.reactionCount == resource.data.reactionCount + 1
            || request.resource.data.reactionCount == resource.data.reactionCount - 1);
    }

    // users/{uid} : プロフィール。閲覧は全ログインユーザー、更新は本人のみ
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // stamps/{uid_date} : カレンダーのワンタップスタンプ。本人のみ書き込み可
    match /stamps/{stampId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // posts/{postId} : テキスト投稿。非公開は本人のみ閲覧可、書き込みは投稿者のみ
    match /posts/{postId} {
      allow read: if signedIn() &&
        (resource.data.isPublic == true || resource.data.authorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.authorUid == request.auth.uid || isReactionCountToggle());
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // monthlyReflections/{uid_month} : 月次AI振り返り。posts同様に公開範囲を判定
    match /monthlyReflections/{reflectionId} {
      allow read: if signedIn() &&
        (resource.data.isPublic == true || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // reactions/{postId_uid} : 炎リアクション。自分の反応のみ作成・削除可
    // ドキュメントIDは「投稿ID_反応する人」に固定し、他人になりすました反応を防ぐ。
    match /reactions/{reactionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && reactionId == request.resource.data.postId + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // follows/{followerUid_followeeUid} : フォロー関係。フォローする本人のみ作成・削除可
    // 自分自身はフォローできない。ドキュメントIDは「フォローする人_される人」に固定する。
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followeeUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followeeUid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }
  }
}
